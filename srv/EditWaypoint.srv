# Edit the waypoint queue by number (1-based, as shown in the RViz markers).
uint32 index
# true: delete the waypoint; false: replace its pose with `pose`
bool remove
# true: keep waypoints 1..index and delete every waypoint after it
# (takes precedence over `remove`; `pose` is ignored)
bool truncate_after
geometry_msgs/Pose pose
---
bool success
string message
